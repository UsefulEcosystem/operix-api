APP_NAME=Operix Service
PORT=3333
NODE_ENV=development
ORIGIN=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
DEPLOYMENT_MODE=LOCAL
FRONTEND_URL=http://localhost:3000

POSTGRES_PASSWORD=admin
POSTGRES_USER=admin
POSTGRES_DB=operix-service
POSTGRES_PORT=5432
DATABASE_URL=postgresql://admin:admin@localhost:5432/operix-service

# Desenvolvimento apenas. Em produção defina um segredo aleatório com 32+ caracteres.
JWT_SECRET=change-this-secret-in-production
JWT_ISSUER=operix-service-api
JWT_AUDIENCE=operix-service-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=operix_refresh_token
EMAIL_FROM=no-reply@operix.local
# Webhook HTTP que envia e-mails transacionais. Obrigatório em produção.
EMAIL_DELIVERY_WEBHOOK_URL=

# Google OAuth direto (opcional; necessário para login social)
# Crie em: https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada (use exatamente esta URL no Google Cloud):
# - Local: http://localhost:3000/oauth/callback.html
# - Produção: https://seu-dominio/oauth/callback.html
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
